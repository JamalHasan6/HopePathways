# Hope Pathways — Backend Environment Variables
# Copy this file to .env and fill in your values

# ─── AI Triage (choose one) ────────────────────────────────────────────────────

# Option A: GitHub Models (free, uses your GitHub PAT with models:read scope)
# Get a token at: https://github.com/settings/tokens  → fine-grained → models:read
GITHUB_TOKEN=your_github_personal_access_token_here

# Option B: OpenAI API key (uses gpt-4o-mini, standard billing)
# OPENAI_API_KEY=sk-...

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── Admin Dashboard Auth ─────────────────────────────────────────────────────
# Password for HTTP Basic Auth on /api/admin routes.
# Leave unset in local dev to skip auth. REQUIRED in production.
ADMIN_PASSWORD=change_this_before_deploying

# ─── Socket.IO Auth ───────────────────────────────────────────────────────────
# Shared secret for Socket.IO admin connections. Leave unset in dev to skip.
SOCKET_SECRET=change_this_socket_secret_before_deploying
